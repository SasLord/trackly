# Rust
target/
**/*.rs.bk
*.pdb

# Cargo lockfile is committed (we ship bin crates), so it's intentionally NOT ignored.

# Node / pnpm
node_modules/
ui/node_modules/
ui/dist/
.vite/
.svelte-kit/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated tauri-specta bindings (regenerated by `cargo test -p trackly-app --test export_bindings`)
ui/src/bindings.ts

# Local databases (portable-mode artifacts that should never be committed)
*.db
*.db-wal
*.db-shm

# Logs
logs/
*.log

# OS / editor
**/.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

# Temp / ProcMon artifacts
**/*.tmp
*.pml
*.pmc.bak

# Optional user configs (portable installs may include trackly.config.toml beside .exe,
# but dev-machine local configs should not leak into git).
trackly.config.toml
