# Rust
target/
**/*.rs.bk
*.pdb

# Cargo lockfile is committed (we ship bin crates), so it's intentionally NOT ignored.

# Node / pnpm
node_modules/
ui/node_modules/
ui/dist/
.vite/
.svelte-kit/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated tauri-specta bindings (regenerated by `cargo test -p trackly-app --test export_bindings`)
ui/src/bindings.ts

# Tauri 2 generated artifacts (rebuilt by `tauri-build` on every compile)
crates/trackly-app/gen/

# Local databases (portable-mode artifacts that should never be committed)
*.db
*.db-wal
*.db-shm

# Logs
logs/
*.log

# OS / editor
**/.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

# Temp / ProcMon artifacts
**/*.tmp
*.pml
*.pmc.bak

# Optional user configs (portable installs may include trackly.config.toml beside .exe,
# but dev-machine local configs should not leak into git).
trackly.config.toml

# Planning reference artifacts may carry real organization samples (PRIV-01/D-04) — ignore
# by default. design-system-v2/ predates this rule (milestone v1.2 mockups) and stays tracked
# intentionally.
.planning/reference/*
!.planning/reference/design-system-v2/
