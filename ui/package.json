{
  "name": "trackly-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prebuild": "cargo test -p trackly-app --test export_bindings",
    "preview": "vite preview",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --ext .ts,.svelte && prettier --check . && node scripts/check-tokens.mjs && node scripts/check-contrast.mjs && node scripts/check-focus-outline.mjs && node scripts/check-pagedjs-csp-hash.mjs && node scripts/check-print-isolation.mjs",
    "tauri": "cd ../crates/trackly-app && node ../../ui/node_modules/@tauri-apps/cli/tauri.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.4.2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-shell": "^2.3.1",
    "pagedjs": "0.4.3",
    "pdfjs-dist": "^4.10.38",
    "svelte": "^5.55.0",
    "svelte-spa-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2.11.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^2.45.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "sass": "^1.80.0",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^1.6.1",
    "svelte-preprocess": "^6.0.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
