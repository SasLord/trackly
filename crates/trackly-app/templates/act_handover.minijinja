{#- Default template for Акт приёма-передачи (kind='act_handover').

  Outputs JSON that deserializes to crates/trackly-app/src/pdf/docspec.rs::DocSpec.

  Available context variables (D-PDF-Templates-Schema-01):
    org.name, org.inn, org.kpp, org.address, org.logo_path
    act.number, act.suffix, act.date, act.date_human,
    act.giver_name, act.receiver_name, act.deadline, act.deadline_human,
    act.location_name, act.items[], act.parent
    return.condition_default, return.location_default

  All optional fields use `{% if … %}` or `{{ … | default("—") }}` (Pitfall 6).
-#}
{
  "title": "Акт приёма-передачи №{{ act.number }}{{ act.suffix | default('') }}",
  "header": {
    "org_name":    {{ org.name | tojson }},
    "org_inn":     {{ org.inn | tojson }},
    "org_kpp":     {{ org.kpp | tojson }},
    "org_address": {{ org.address | tojson }},
    "logo_path":   {{ org.logo_path | default(none) | tojson }},
    "act_label":   {{ ("Акт приёма-передачи №" ~ act.number ~ (act.suffix | default(''))) | tojson }},
    "date_label":  {{ act.date_human | default(act.date) | tojson }}
  },
  "sections": [
    {
      "type": "heading",
      "level": 1,
      "text": {{ ("Акт приёма-передачи №" ~ act.number ~ (act.suffix | default(''))) | tojson }}
    },
    {
      "type": "spacer",
      "height_pt": 8.0
    },
    {
      "type": "key_value_table",
      "rows": [
        { "key": "Дата",          "value": {{ act.date_human | default(act.date) | tojson }} },
        { "key": "Сдал",          "value": {{ act.giver_name | tojson }} },
        { "key": "Принял",        "value": {{ act.receiver_name | tojson }} },
        { "key": "Расположение",  "value": {{ (act.location_name | default("—")) | tojson }} }
        {%- if act.deadline_human %},
        { "key": "Сроком до",     "value": {{ act.deadline_human | tojson }} }
        {%- elif act.deadline %},
        { "key": "Сроком до",     "value": {{ act.deadline | tojson }} }
        {%- endif %}
        {%- if act.parent %},
        { "key": "По акту",       "value": {{ (("№" ~ act.parent.number) ~ (" от " ~ (act.parent.date_human | default(act.parent.date | default(""))))) | tojson }} }
        {%- endif %}
      ]
    },
    {
      "type": "spacer",
      "height_pt": 12.0
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Позиции"
    },
    {
      "type": "items_table",
      "columns": ["№", "Наименование", "Инв.№", "Серийный №", "Модель", "Кол-во"],
      "rows": [
        {%- for item in act.items %}
        [
          {{ loop.index | string | tojson }},
          {{ item.name | tojson }},
          {{ (item.inventory_no | default("—")) | tojson }},
          {{ (item.serial_no | default("—")) | tojson }},
          {{ (item.model | default("—")) | tojson }},
          {{ (item.quantity | default(1) | string) | tojson }}
        ]{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    },
    {
      "type": "spacer",
      "height_pt": 24.0
    },
    {
      "type": "signature",
      "left_label":  {{ ("Сдал: " ~ act.giver_name) | tojson }},
      "right_label": {{ ("Принял: " ~ act.receiver_name) | tojson }},
      "spacer_pt": 30.0
    }
  ]
}
