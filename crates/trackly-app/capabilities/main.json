{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Trackly main window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$TEMP/**/*.pdf" },
        { "path": "$HOME/**/*.pdf" },
        { "path": "$DOCUMENT/**/*.pdf" },
        { "path": "$DESKTOP/**/*.pdf" },
        { "path": "$DOWNLOAD/**/*.pdf" }
      ]
    }
  ]
}
