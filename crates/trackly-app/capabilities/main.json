{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Trackly main window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$TEMP/**/*.pdf" },
        { "path": "$HOME/**/*.pdf" },
        { "path": "$DOCUMENT/**/*.pdf" },
        { "path": "$DESKTOP/**/*.pdf" },
        { "path": "$DOWNLOAD/**/*.pdf" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$TEMP/*.html" }, { "path": "$TEMP/**/*.html" }]
    },
    "shell:allow-open"
  ]
}
